# COPY this file to .env.local — do not rename it. This template stays in git;
# .env.local is ignored and holds your real values.
#
# The app runs fine with DATABASE_URL and GEMINI_* empty:
#   - events log to the browser console instead of the database
#   - questions fall back to the built-in seed bank (lib/game/questions.ts)
# SESSION_SECRET is the exception: signup and login fail without it.

# Neon Postgres — use the POOLED connection string.
# neon.tech -> your project -> Connection Details -> toggle "Pooled connection".
DATABASE_URL=

# Secret used to sign the session cookie (HMAC-SHA256). Required for auth —
# the server throws rather than falling back to a default. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it logs every student out; keep it stable for the whole pilot.
SESSION_SECRET=

# Gemini API key (Google AI Studio) — only needed to run scripts/generate-questions.mjs.
GEMINI_API_KEY=
# Model for question generation. The script's built-in default is old — set this.
# Current tier as of 21 Jul 2026: Gemini 3.6 Flash ($1.50/$7.50 per 1M tokens) and
# Gemini 3.5 Flash-Lite ($0.30/$2.50, built for high-volume simple jobs).
# **Flash-Lite is the right choice for bulk MCQ generation** — 5x cheaper, and the
# task is schema-constrained rather than reasoning-heavy.
# Confirm the exact API model string in Google AI Studio before generating the real
# question bank; product names and API ids differ, and a wrong id fails at runtime.
# Rate limits are now project-specific — check the AI Studio console, not the docs.
GEMINI_MODEL=
